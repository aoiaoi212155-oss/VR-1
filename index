<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
  <title>AI Vision Tour - Street View & WebXR</title>
  <!-- Three.js & WebXR -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body {
      margin: 0;
      overflow: hidden;
      background: #000;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    #canvas-container {
      width: 100vw;
      height: 100vh;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;
    }
    .hud-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 10;
    }
    .pointer-auto {
      pointer-events: auto;
    }
    .glass-panel {
      background: rgba(10, 15, 29, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(0, 240, 255, 0.25);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.58), inset 0 0 15px rgba(0, 240, 255, 0.05);
    }
    /* 視野中心のレティクル（照準） */
    .reticle {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 48px;
      height: 48px;
      border: 2px dashed rgba(0, 240, 255, 0.5);
      border-radius: 50%;
      pointer-events: none;
      transition: all 0.2s ease;
    }
    .reticle::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 6px;
      height: 6px;
      background: #00f0ff;
      border-radius: 50%;
      box-shadow: 0 0 8px #00f0ff;
    }
    .reticle.scanning {
      border-color: #ffaa00;
      transform: translate(-50%, -50%) scale(1.25) rotate(45deg);
      box-shadow: 0 0 20px rgba(255, 170, 0, 0.4);
    }
  </style>
</head>
<body class="text-white select-none">
  <!-- 3D WebXR レンダリング領域 -->
  <div id="canvas-container"></div>

  <!-- HUD UI オーバーレイ -->
  <div class="hud-overlay flex flex-col justify-between p-4 md:p-6">
    <!-- 上部ヘッダー & ナビゲーション -->
    <div class="flex justify-between items-start">
      <!-- ロケーション・コンパス情報 -->
      <div class="glass-panel rounded-xl p-3 md:p-4 text-xs md:text-sm flex flex-col gap-1 max-w-sm pointer-auto">
        <div class="flex items-center gap-2 text-cyan-400 font-mono tracking-wider">
          <i data-lucide="map-pin" class="w-4 h-4 animate-pulse"></i>
          <span id="loc-name" class="font-bold">田舎のあぜ道 (日本)</span>
        </div>
        <div class="text-gray-400 font-mono text-[11px] flex items-center gap-3">
          <span id="loc-coords">34.075, 134.559</span>
          <span class="text-cyan-600">|</span>
          <span id="loc-heading">方位: 000° (北)</span>
        </div>
      </div>

      <!-- 右上コントロールパネル -->
      <div class="flex items-center gap-2 pointer-auto">
        <!-- 田舎・秘境ランダムジャンプボタン -->
        <button id="btn-rural-jump" title="田舎の道端へランダムジャンプ" class="glass-panel hover:bg-emerald-950/40 text-emerald-400 px-3 py-2 rounded-xl flex items-center gap-2 border border-emerald-500/40 transition">
          <i data-lucide="sprout" class="w-4 h-4"></i>
          <span class="hidden md:inline text-xs font-semibold">田舎の道端へ飛ぶ</span>
        </button>

        <!-- 設定モーダル開く -->
        <button id="btn-settings" class="glass-panel hover:bg-cyan-950/40 text-cyan-300 p-2.5 rounded-xl border border-cyan-500/30 transition">
          <i data-lucide="settings" class="w-5 h-5"></i>
        </button>

        <!-- WebXR / VR モード切り替え -->
        <button id="btn-vr" class="glass-panel bg-cyan-500/20 hover:bg-cyan-500/40 text-cyan-300 font-mono text-xs px-3 py-2.5 rounded-xl border border-cyan-400/50 flex items-center gap-2 transition">
          <i data-lucide="glasses" class="w-4 h-4"></i>
          <span>ENTER VR</span>
        </button>
      </div>
    </div>

    <!-- 視野中心の照準 -->
    <div id="reticle" class="reticle"></div>

    <!-- 下部: AI ガイド対話インターフェース -->
    <div class="flex flex-col items-center gap-3 w-full max-w-2xl mx-auto">
      <!-- ガイドの発言字幕バルーン -->
      <div id="ai-caption" class="glass-panel p-4 rounded-2xl w-full text-center text-sm md:text-base border-cyan-500/30 shadow-2xl relative pointer-auto">
        <div class="flex items-center justify-center gap-2 mb-1.5 text-xs text-cyan-400 font-mono uppercase tracking-widest">
          <span class="inline-block w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          AI Companion : LUMA
        </div>
        <p id="caption-text" class="text-gray-100 leading-relaxed font-sans">
          「のどかな日本のあぜ道にやってきました。深呼吸したくなるような静けさですね。正面に見える景色や、気になる小道があれば教えてください。」
        </p>
      </div>

      <!-- コントロールボタン群 -->
      <div class="flex items-center gap-3 pointer-auto">
        <!-- 視線・景色スキャン＆解説 -->
        <button id="btn-scan" class="glass-panel hover:bg-cyan-950/50 text-cyan-300 px-4 py-3 rounded-full flex items-center gap-2 border border-cyan-400/40 shadow-lg active:scale-95 transition">
          <i data-lucide="eye" class="w-5 h-5 text-cyan-400"></i>
          <span class="text-xs font-bold tracking-wide">この方向を解説</span>
        </button>

        <!-- 音声で質問マイクボタン -->
        <button id="btn-mic" class="bg-gradient-to-tr from-cyan-600 to-blue-500 hover:from-cyan-500 hover:to-blue-400 text-white p-4 rounded-full shadow-lg shadow-cyan-500/25 active:scale-95 transition relative">
          <i data-lucide="mic" class="w-6 h-6"></i>
          <span id="mic-pulse" class="hidden absolute inset-0 rounded-full border-2 border-white animate-ping"></span>
        </button>

        <!-- 別の方角へテレポート/歩く -->
        <button id="btn-random-walk" class="glass-panel hover:bg-amber-950/50 text-amber-300 px-4 py-3 rounded-full flex items-center gap-2 border border-amber-400/40 shadow-lg active:scale-95 transition">
          <i data-lucide="footprints" class="w-5 h-5 text-amber-400"></i>
          <span class="text-xs font-bold tracking-wide">道を歩く</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 設定・APIキー入力モーダル -->
  <div id="modal-settings" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
    <div class="glass-panel rounded-2xl p-6 max-w-md w-full border border-cyan-500/40 shadow-2xl">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold text-cyan-300 flex items-center gap-2">
          <i data-lucide="sliders" class="w-5 h-5"></i> 接続・システム設定
        </h3>
        <button id="btn-close-settings" class="text-gray-400 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="space-y-4 text-xs">
        <div>
          <label class="block text-gray-300 mb-1 font-semibold">Google Maps API Key (Street View用)</label>
          <input id="input-gmaps-key" type="password" placeholder="AIzaSy..." class="w-full bg-slate-900/90 border border-slate-700 rounded-lg p-2.5 text-cyan-300 focus:outline-none focus:border-cyan-400" />
          <p class="text-[10px] text-gray-400 mt-1">※未入力の場合は高解像度パノラマ・シミュレータが動作します。</p>
        </div>

        <div>
          <label class="block text-gray-300 mb-1 font-semibold">Gemini API Key (マルチモーダルAI解説用)</label>
          <input id="input-gemini-key" type="password" placeholder="AIzaSy..." class="w-full bg-slate-900/90 border border-slate-700 rounded-lg p-2.5 text-cyan-300 focus:outline-none focus:border-cyan-400" />
          <p class="text-[10px] text-gray-400 mt-1">※視覚画像と現在地メタデータを元にリアルタイム解説を生成します。</p>
        </div>

        <div>
          <label class="block text-gray-300 mb-1 font-semibold">地名・住所・緯度経度へ直接移動</label>
          <div class="flex gap-2">
            <input id="input-custom-location" type="text" placeholder="例: 徳島県祖谷山道, 34.07, 134.55" class="w-full bg-slate-900/90 border border-slate-700 rounded-lg p-2.5 text-gray-200 focus:outline-none focus:border-cyan-400" />
            <button id="btn-search-go" class="bg-cyan-600 hover:bg-cyan-500 text-white px-4 rounded-lg font-bold">Go</button>
          </div>
        </div>
      </div>

      <div class="mt-6 flex justify-end">
        <button id="btn-save-settings" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-5 py-2 rounded-xl transition">
          保存して閉じる
        </button>
      </div>
    </div>
  </div>

  <script>
    // アイコン初期化
    lucide.createIcons();

    /* ============================================================
     * 1. 田舎の道端・秘境スポットの座標データベース
     * ============================================================ */
    const RURAL_SPOTS = [
      { name: "徳島県 那賀町の山間峠道", lat: 33.8213, lng: 134.3312, panoFallback: "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=2000&q=80" },
      { name: "長野県 安曇野の水田あぜ道", lat: 36.3051, lng: 137.9015, panoFallback: "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2000&q=80" },
      { name: "北海道 美瑛のなだらかな農道", lat: 43.5855, lng: 142.4589, panoFallback: "https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=2000&q=80" },
      { name: "山形県 最上川沿いの田舎道", lat: 38.6812, lng: 140.2391, panoFallback: "https://images.unsplash.com/photo-1511497584788-87676104235f?auto=format&fit=crop&w=2000&q=80" },
      { name: "京都府 美山町のかやぶきの里の路地", lat: 35.3197, lng: 135.5312, panoFallback: "https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=2000&q=80" },
      { name: "高知県 四万十川の沈下橋付近の小道", lat: 33.0234, lng: 132.9341, panoFallback: "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=2000&q=80" },
      { name: "アイルランド コネマラの羊が通る一本道", lat: 53.4862, lng: -9.8924, panoFallback: "https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=2000&q=80" }
    ];

    let currentSpotIndex = 0;
    let currentCoords = { lat: RURAL_SPOTS[0].lat, lng: RURAL_SPOTS[0].lng };
    let currentAddress = RURAL_SPOTS[0].name;

    /* ============================================================
     * 2. Three.js & WebXR セットアップ
     * ============================================================ */
    let scene, camera, renderer, sphereMesh, textureLoader;
    let isUserInteracting = false, onPointerDownMouseX = 0, onPointerDownMouseY = 0;
    let lon = 0, onPointerDownLon = 0, lat = 0, onPointerDownLat = 0;
    let phi = 0, theta = 0;

    const container = document.getElementById('canvas-container');

    function initThree() {
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 1, 1100);
      camera.target = new THREE.Vector3(0, 0, 0);

      // 360度パノラマ球体（内側にテクスチャを貼る）
      const geometry = new THREE.SphereGeometry(500, 60, 40);
      geometry.scale(-1, 1, 1);

      textureLoader = new THREE.TextureLoader();
      const material = new THREE.MeshBasicMaterial({
        map: textureLoader.load(RURAL_SPOTS[0].panoFallback)
      });

      sphereMesh = new THREE.Mesh(geometry, material);
      scene.add(sphereMesh);

      renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
      renderer.setPixelRatio(window.devicePixelRatio);
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.xr.enabled = true; // WebXR 有効化
      container.appendChild(renderer.domElement);

      // マウス / タッチドラッグ操作
      container.addEventListener('pointerdown', onPointerDown);
      document.addEventListener('pointermove', onPointerMove);
      document.addEventListener('pointerup', onPointerUp);
      window.addEventListener('resize', onWindowResize);

      // レンダリングループ
      renderer.setAnimationLoop(renderLoop);
    }

    function onPointerDown(event) {
      if (event.isPrimary === false) return;
      isUserInteracting = true;
      onPointerDownMouseX = event.clientX;
      onPointerDownMouseY = event.clientY;
      onPointerDownLon = lon;
      onPointerDownLat = lat;
    }

    function onPointerMove(event) {
      if (event.isPrimary === false || !isUserInteracting) return;
      lon = (onPointerDownMouseX - event.clientX) * 0.15 + onPointerDownLon;
      lat = (event.clientY - onPointerDownMouseY) * 0.15 + onPointerDownLat;
    }

    function onPointerUp(event) {
      if (event.isPrimary === false) return;
      isUserInteracting = false;
    }

    function onWindowResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function renderLoop() {
      // VR セッション中でない場合は手動カメラ制御
      if (!renderer.xr.isPresenting) {
        lat = Math.max(-85, Math.min(85, lat));
        phi = THREE.MathUtils.degToRad(90 - lat);
        theta = THREE.MathUtils.degToRad(lon);

        camera.target.x = 500 * Math.sin(phi) * Math.cos(theta);
        camera.target.y = 500 * Math.cos(phi);
        camera.target.z = 500 * Math.sin(phi) * Math.sin(theta);
        camera.lookAt(camera.target);

        // 方位角HUD更新
        let headingDeg = Math.round((lon % 360 + 360) % 360);
        let cardinal = getCardinalDirection(headingDeg);
        document.getElementById('loc-heading').innerText = `方位: ${headingDeg.toString().padStart(3, '0')}° (${cardinal})`;
      }
      renderer.render(scene, camera);
    }

    function getCardinalDirection(deg) {
      const dirs = ['北', '北東', '東', '南東', '南', '南西', '西', '北西'];
      return dirs[Math.round(deg / 45) % 8];
    }

    /* ============================================================
     * 3. Google Street View パノラマ読み込みロジック
     * ============================================================ */
    let svService = null;

    function initGoogleMapsAPI(apiKey) {
      if (window.google && window.google.maps) return;
      const script = document.createElement('script');
      script.src = `https://maps.googleapis.com/maps/api/js?key=${apiKey}&callback=onGoogleMapsLoaded`;
      script.async = true;
      script.defer = true;
      window.onGoogleMapsLoaded = () => {
        svService = new google.maps.StreetViewService();
        console.log("Google Maps Street View Service Ready.");
      };
      document.head.appendChild(script);
    }

    // 指定座標付近のストリートビューを検索してパノラマテクスチャを差し替える
    function loadStreetViewAt(lat, lng, spotTitle) {
      document.getElementById('loc-name').innerText = spotTitle || "田舎の道端へ移動中...";
      document.getElementById('loc-coords').innerText = `${lat.toFixed(4)}, ${lng.toFixed(4)}`;

      const gApiKey = localStorage.getItem('gmaps_api_key');
      if (gApiKey && window.google && window.google.maps && svService) {
        // 半径200m以内のストリートビューを検索
        const location = new google.maps.LatLng(lat, lng);
        svService.getPanorama({ location: location, radius: 250, preference: google.maps.StreetViewPreference.NEAREST }, (data, status) => {
          if (status === google.maps.StreetViewStatus.OK) {
            const panoId = data.location.pano;
            currentAddress = data.location.description || spotTitle;
            document.getElementById('loc-name').innerText = currentAddress;

            // Google Street View Static API から 360度パノラマ画像を取得（またはタイル取得）
            const panoramaUrl = `https://maps.googleapis.com/maps/api/streetview?size=2048x1024&pano=${panoId}&key=${gApiKey}`;
            updatePanoramaTexture(panoramaUrl);
          } else {
            fallbackLocalPanorama(spotTitle);
          }
        });
      } else {
        fallbackLocalPanorama(spotTitle);
      }
    }

    function fallbackLocalPanorama(spotTitle) {
      const spot = RURAL_SPOTS[currentSpotIndex % RURAL_SPOTS.length];
      currentAddress = spotTitle || spot.name;
      document.getElementById('loc-name').innerText = currentAddress;
      updatePanoramaTexture(spot.panoFallback);
    }

    function updatePanoramaTexture(url) {
      textureLoader.load(url, (texture) => {
        sphereMesh.material.map = texture;
        sphereMesh.material.needsUpdate = true;
        speakGuidance(`「${currentAddress}」に到着しました。のどかな風が吹いていますね。`);
      });
    }

    /* ============================================================
     * 4. AI ガイド対話 & リアルタイム視覚解析 (Gemini Vision)
     * ============================================================ */
    const captionEl = document.getElementById('caption-text');
    const reticleEl = document.getElementById('reticle');

    // 視野中心の画像をキャプチャする
    function captureFieldOfView() {
      const canvas = renderer.domElement;
      // 画面中央 512x512 をクロップ
      const cropSize = Math.min(canvas.width, canvas.height, 512);
      const cropCanvas = document.createElement('canvas');
      cropCanvas.width = cropSize;
      cropCanvas.height = cropSize;
      const ctx = cropCanvas.getContext('2d');
      ctx.drawImage(
        canvas,
        (canvas.width - cropSize) / 2,
        (canvas.height - cropSize) / 2,
        cropSize,
        cropSize,
        0,
        0,
        cropSize,
        cropSize
      );
      return cropCanvas.toDataURL('image/jpeg', 0.85).split(',')[1];
    }

    // AIに解説をリクエスト
    async function requestAIGuide(userPrompt = "") {
      reticleEl.classList.add('scanning');
      captionEl.innerText = "周囲の風景をスキャンして分析中...";

      const geminiApiKey = localStorage.getItem('gemini_api_key');
      const base64Image = captureFieldOfView();
      const headingDeg = Math.round((lon % 360 + 360) % 360);
      const cardinal = getCardinalDirection(headingDeg);

      const promptContext = `
あなたは優しく博識な旅行ガイド「LUMA」です。
現在ユーザーは以下の場所に立っています：
・場所: ${currentAddress} (座標: ${currentCoords.lat}, ${currentCoords.lng})
・現在向いている方角: ${cardinal} (${headingDeg}度)

送付された画像は、ユーザーがいま視界の中心で見ている現地の風景です。
ユーザーからの質問: "${userPrompt || 'この方向に見える風景や、この田舎道の特徴について教えて'}"

【回答ルール】
・2〜3文（120文字程度）で親しみやすく語りかけてください。
・田舎ののどかさ、植物や農村・山道の情景、土や草の匂い、風の音などを感じさせる情緒的な表現を入れてください。
      `;

      if (geminiApiKey) {
        try {
          const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${geminiApiKey}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{
                parts: [
                  { text: promptContext },
                  { inline_data: { mime_type: "image/jpeg", data: base64Image } }
                ]
              }]
            })
          });
          const data = await response.json();
          const aiText = data.candidates?.[0]?.content?.parts?.[0]?.text || "見渡す限りのどかな道が続いています。";
          speakGuidance(aiText);
        } catch (err) {
          console.error(err);
          speakGuidance("通信に問題がありましたが、この方角には美しい田園風景と畦道が広がっていますね。");
        }
      } else {
        // APIキー未設定時のスマートシミュレーション
        setTimeout(() => {
          const simulated = [
            `正面の方角（${cardinal}）には、のどかな畦道と山並みが続いています。初夏にはカエルの合唱や用水路のせせらぎが聞こえてきそうな場所ですね。`,
            `見渡す限りの青空と緑が広がっています。このあたりは昔ながらの農道で、道端にはタンポポやオオイヌノフグリが咲いていそうです。`,
            `静かな一本道ですね。都会の喧騒を離れて、土と草の香りを胸いっぱいに吸い込みたくなります。あの奥の小道をもう少し進んでみましょうか。`
          ];
          speakGuidance(simulated[Math.floor(Math.random() * simulated.length)]);
        }, 800);
      }

      reticleEl.classList.remove('scanning');
    }

    // 音声合成（TTS）
    function speakGuidance(text) {
      captionEl.innerText = text;
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        utter.lang = 'ja-JP';
        utter.rate = 1.05;
        window.speechSynthesis.speak(utter);
      }
    }

    /* ============================================================
     * 5. 音声入力（STT）
     * ============================================================ */
    const micBtn = document.getElementById('btn-mic');
    const micPulse = document.getElementById('mic-pulse');
    let recognition = null;

    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();
      recognition.lang = 'ja-JP';
      recognition.onstart = () => micPulse.classList.remove('hidden');
      recognition.onend = () => micPulse.classList.add('hidden');
      recognition.onresult = (e) => {
        const text = e.results[0][0].transcript;
        captionEl.innerText = `「${text}」`;
        requestAIGuide(text);
      };
    }

    micBtn.addEventListener('click', () => {
      if (recognition) {
        recognition.start();
      } else {
        alert("お使いのブラウザは音声認識をサポートしていません。ChromeまたはQuestブラウザをご利用ください。");
      }
    });

    /* ============================================================
     * 6. イベントリスナー & 操作UI
     * ============================================================ */
    // 田舎ジャンプ
    document.getElementById('btn-rural-jump').addEventListener('click', () => {
      currentSpotIndex = (currentSpotIndex + 1) % RURAL_SPOTS.length;
      const spot = RURAL_SPOTS[currentSpotIndex];
      currentCoords = { lat: spot.lat, lng: spot.lng };
      loadStreetViewAt(spot.lat, spot.lng, spot.name);
    });

    // 道を歩く（少し前進・テレポート）
    document.getElementById('btn-random-walk').addEventListener('click', () => {
      // 現在の向きに少しだけ座標を進める（簡易歩行シミュレーション）
      const step = 0.0003;
      const rad = THREE.MathUtils.degToRad(lon);
      currentCoords.lat += step * Math.cos(rad);
      currentCoords.lng += step * Math.sin(rad);
      loadStreetViewAt(currentCoords.lat, currentCoords.lng, currentAddress);
    });

    // 視界解説ボタン
    document.getElementById('btn-scan').addEventListener('click', () => requestAIGuide());

    // 設定モーダル
    const modalSettings = document.getElementById('modal-settings');
    document.getElementById('btn-settings').addEventListener('click', () => {
      document.getElementById('input-gmaps-key').value = localStorage.getItem('gmaps_api_key') || '';
      document.getElementById('input-gemini-key').value = localStorage.getItem('gemini_api_key') || '';
      modalSettings.classList.remove('hidden');
    });
    document.getElementById('btn-close-settings').addEventListener('click', () => modalSettings.classList.add('hidden'));
    document.getElementById('btn-save-settings').addEventListener('click', () => {
      const gKey = document.getElementById('input-gmaps-key').value.trim();
      const gemKey = document.getElementById('input-gemini-key').value.trim();
      if (gKey) {
        localStorage.setItem('gmaps_api_key', gKey);
        initGoogleMapsAPI(gKey);
      }
      if (gemKey) localStorage.setItem('gemini_api_key', gemKey);
      modalSettings.classList.add('hidden');
    });

    // 地名検索
    document.getElementById('btn-search-go').addEventListener('click', () => {
      const query = document.getElementById('input-custom-location').value.trim();
      if (!query) return;
      if (query.includes(',')) {
        const [lat, lng] = query.split(',').map(v => parseFloat(v));
        if (!isNaN(lat) && !isNaN(lng)) {
          currentCoords = { lat, lng };
          loadStreetViewAt(lat, lng, `座標: ${lat}, ${lng}`);
          modalSettings.classList.add('hidden');
          return;
        }
      }
      loadStreetViewAt(currentCoords.lat, currentCoords.lng, query);
      modalSettings.classList.add('hidden');
    });

    // WebXR / VR セッション開始
    document.getElementById('btn-vr').addEventListener('click', async () => {
      if ('xr' in navigator) {
        try {
          const supported = await navigator.xr.isSessionSupported('immersive-vr');
          if (supported) {
            const session = await navigator.xr.requestSession('immersive-vr');
            renderer.xr.setSession(session);
          } else {
            alert('VRデバイスが検出されませんでした。Meta Quest等のブラウザでお試しください。');
          }
        } catch (e) {
          alert('WebXRセッションの開始に失敗しました: ' + e.message);
        }
      } else {
        alert('このブラウザはWebXRに対応していません。');
      }
    });

    // 初期化実行
    initThree();
    const savedGKey = localStorage.getItem('gmaps_api_key');
    if (savedGKey) initGoogleMapsAPI(savedGKey);
  </script>
</body>
</html>
